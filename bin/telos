#!/usr/bin/env bash
#
# telos — Cybersecurity Services Practice CLI
# Generic VAPT/GAPT testing harness wrapping Claude Code.
#

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
OUTPUT_DIR="$PROJECT_ROOT/output"
COMBINED_INDEX="$PROJECT_ROOT/skills/custom/combined-index.json"

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
BOLD='\033[1m'
NC='\033[0m'

ENGAGEMENT_TYPES=(
  "web-vapt"          "Web application VAPT"
  "network-vapt"      "Network VAPT"
  "cloud-vapt"        "Cloud VAPT (AWS/Azure/GCP/Alibaba/Oracle)"
  "mobile-pt"         "Mobile app penetration test"
  "api-pt"            "API penetration test"
  "k8s-pt"            "Kubernetes penetration test"
  "thick-client-pt"   "Thick client penetration test"
  "source-code-review" "Source code security review"
  "gapt"              "GenAI application penetration test"
  "mcp-audit"         "MCP server/client security audit"
  "red-team"          "Red team / adversary simulation"
  "dfir"              "Digital forensics & incident response"
  "threat-hunt"       "Threat hunting"
  "recon"             "Reconnaissance / OSINT"
)

usage() {
  cat <<EOF
${BOLD}telos${NC} — Cybersecurity Services Practice CLI

USAGE:
  telos <command> [options]

ENGAGEMENT COMMANDS:
  scope <description>             Bootstrap engagement scope (auto-detects type)
  recon <target>                  Perform reconnaissance for a target
  testplan <scope-file>           Generate prioritised test plan
  execute <testplan-file>         Generate execution runbook from test plan
  report <results-file>           Generate findings report

SKILL COMMANDS:
  list-skills [filter]            Search skills across all libraries
  show-skill <skill-name>         Display a single skill's full content
  list-types                      List all engagement types

UTILITY:
  rebuild-index                   Regenerate combined-index.json
  version                         Show version + skill counts

OPTIONS:
  --type <engagement-type>        Force engagement type (skip auto-detect)
  --library <name>                Restrict to a skill library: cyber | gapt | all
  --frameworks <list>             Filter by frameworks: owasp,mitre-attack,nist-csf,etc.
  --output <file>                 Override default output filename
  --quiet                         Suppress progress output

EXAMPLES:
  telos scope "AWS EKS cluster with public ALB and an LLM chatbot"
  telos scope "internal app" --type web-vapt
  telos list-skills cloud
  telos list-skills --library gapt --frameworks mcp
  telos show-skill testing-mcp-tool-description-injection-attacks
  telos scope "..." > /tmp/scope.md
  telos testplan /tmp/scope.md
  telos execute output/testplan-*.md

OUTPUT: All artifacts written to ${OUTPUT_DIR}/
EOF
}

log()  { [[ "${QUIET:-0}" == "1" ]] || echo -e "$@"; }
warn() { echo -e "${YELLOW}⚠ $*${NC}" >&2; }
die()  { echo -e "${RED}✗ $*${NC}" >&2; exit 1; }

run_claude() {
  local prompt="$1"
  local output_file="$2"

  log "${YELLOW}→ Running Claude Code (this may take 1-5 minutes)...${NC}"

  cd "$PROJECT_ROOT"
  if claude -p "$prompt" > "$output_file" 2>&1; then
    log "${GREEN}✓ Output: $output_file${NC}"
  else
    echo -e "${RED}✗ Claude Code failed:${NC}" >&2
    cat "$output_file" >&2
    return 1
  fi
}

ensure_index() {
  if [[ ! -f "$COMBINED_INDEX" ]]; then
    warn "Combined index missing — building it now..."
    python3 "$PROJECT_ROOT/scripts/build-combined-index.py" || die "Failed to build index"
  fi
}

parse_options() {
  TYPE=""
  LIBRARY="all"
  FRAMEWORKS=""
  OUTPUT_OVERRIDE=""
  QUIET=0
  POSITIONAL=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --type)        TYPE="$2"; shift 2 ;;
      --library)     LIBRARY="$2"; shift 2 ;;
      --frameworks)  FRAMEWORKS="$2"; shift 2 ;;
      --output)      OUTPUT_OVERRIDE="$2"; shift 2 ;;
      --quiet)       QUIET=1; shift ;;
      --help|-h)     usage; exit 0 ;;
      --*)           die "Unknown option: $1" ;;
      *)             POSITIONAL+=("$1"); shift ;;
    esac
  done
}

cmd_scope() {
  parse_options "$@"
  local description="${POSITIONAL[*]:-}"
  [[ -z "$description" ]] && die "scope requires a target description"

  ensure_index
  local timestamp=$(date +%Y%m%d-%H%M%S)
  local output_file="${OUTPUT_OVERRIDE:-$OUTPUT_DIR/scope-$timestamp.md}"

  local type_hint=""
  [[ -n "$TYPE" ]] && type_hint="The engagement type is forced to: $TYPE."

  local prompt="You are bootstrapping a cybersecurity engagement scope.

Target description: $description
$type_hint

Steps:
1. Identify the engagement type(s) — one or more from config/domains.yaml.
   For composite targets (e.g., 'AWS + LLM chatbot'), list multiple types.
2. For each identified type, list the relevant skill subdomains from skills/custom/combined-index.json.
3. Outline likely attack surfaces for the target.
4. Recommend in-scope test categories with skill IDs.
5. List out-of-scope items the tester should confirm with the client.
6. List prerequisites: access, credentials, target environment, tooling.

Output as a structured markdown scope document suitable for client review."

  run_claude "$prompt" "$output_file"
}

cmd_recon() {
  parse_options "$@"
  local target="${POSITIONAL[0]:-}"
  [[ -z "$target" ]] && die "recon requires a target (URL, hostname, IP range, etc.)"

  ensure_index
  local timestamp=$(date +%Y%m%d-%H%M%S)
  local output_file="${OUTPUT_OVERRIDE:-$OUTPUT_DIR/recon-$timestamp.md}"

  local type_hint="Auto-detect the engagement type from the target."
  [[ -n "$TYPE" ]] && type_hint="The engagement type is: $TYPE."

  local prompt="Generate a reconnaissance plan for target: $target

$type_hint

Use skills/custom/combined-index.json to identify recon-relevant skills. Produce:
- Information gathering steps appropriate to the target type
- Specific commands (curl, nmap, dig, gobuster, gau, subfinder, kubectl, aws cli, 
  jwt_tool, etc.) the tester should run, ordered by priority
- What to record from each step
- Which test cases the recon findings should feed into next

Do not execute network requests — produce a checklist only."

  run_claude "$prompt" "$output_file"
}

cmd_testplan() {
  parse_options "$@"
  local scope_file="${POSITIONAL[0]:-}"
  [[ ! -f "$scope_file" ]] && die "scope file not found: $scope_file"

  ensure_index
  local timestamp=$(date +%Y%m%d-%H%M%S)
  local output_file="${OUTPUT_OVERRIDE:-$OUTPUT_DIR/testplan-$timestamp.md}"
  local scope_content=$(cat "$scope_file")

  local prompt="Generate a prioritised test plan from this scope:

---SCOPE---
$scope_content
---END SCOPE---

For the top 15-25 most relevant test cases (skills/custom/combined-index.json):
- Skill ID and name (use GAPT-XXX for custom, full name for open-source)
- Source library (cyber / gapt)
- Why it's prioritised for this target
- Framework mappings (OWASP/MITRE ATT&CK/ATLAS/NIST)
- Estimated effort (low/medium/high)
- Severity if exploitable

Output: markdown table + execution-order recommendation grouped by prerequisite."

  run_claude "$prompt" "$output_file"
}

cmd_execute() {
  parse_options "$@"
  local plan_file="${POSITIONAL[0]:-}"
  [[ ! -f "$plan_file" ]] && die "test plan file not found: $plan_file"

  local timestamp=$(date +%Y%m%d-%H%M%S)
  local output_file="${OUTPUT_OVERRIDE:-$OUTPUT_DIR/runbook-$timestamp.md}"
  local plan_content=$(cat "$plan_file")

  local prompt="Generate detailed execution guidance for this test plan:

---PLAN---
$plan_content
---END PLAN---

For each test case, load its SKILL.md and produce:
- Step-by-step execution instructions
- Sample payloads / commands (3-5 variants)
- Success signals (objective, defined before testing)
- Evidence to capture (commands to log, screenshots, response captures)
- Reproduction steps for the report

Output as a structured runbook with table of contents."

  run_claude "$prompt" "$output_file"
}

cmd_report() {
  parse_options "$@"
  local results_file="${POSITIONAL[0]:-}"
  [[ ! -f "$results_file" ]] && die "results file not found: $results_file"

  local timestamp=$(date +%Y%m%d-%H%M%S)
  local output_file="${OUTPUT_OVERRIDE:-$OUTPUT_DIR/report-$timestamp.md}"
  local results_content=$(cat "$results_file")

  local prompt="Generate a findings report from these test results:

---RESULTS---
$results_content
---END RESULTS---

For each confirmed finding:
- Title, severity (Critical/High/Medium/Low/Info), CVSS 3.1 score (use 4.0 if applicable)
- Description, evidence, business impact
- Framework mappings: OWASP (Top 10 / API / LLM / ASI / MCP), MITRE ATT&CK,
  MITRE ATLAS, NIST CSF, NIST AI RMF, CIS Benchmarks (whichever apply)
- Reproduction steps
- Remediation guidance with priority and effort

Use templates/report.md if present. Include executive summary at top."

  run_claude "$prompt" "$output_file"
}

cmd_list_skills() {
  parse_options "$@"
  local filter="${POSITIONAL[*]:-}"
  ensure_index

  python3 - <<PYEOF
import json
filter_term = "$filter".lower().strip()
library = "$LIBRARY"
frameworks = "$FRAMEWORKS".lower()

with open("$COMBINED_INDEX") as f:
    idx = json.load(f)

skills = idx["skills"]

if library != "all":
    skills = [s for s in skills if s.get("_namespace") == library]

if filter_term:
    def matches(s):
        haystack = " ".join([
            s.get("name", ""),
            s.get("category", ""),
            s.get("subdomain", ""),
            " ".join(s.get("tags", [])),
            " ".join(str(v) for v in (s.get("frameworks") or {}).values() if v),
            s.get("description", "")[:200],
        ]).lower()
        return all(term in haystack for term in filter_term.split())
    skills = [s for s in skills if matches(s)]

if frameworks:
    fw_filters = [f.strip() for f in frameworks.split(",")]
    def has_fw(s):
        s_fw = s.get("frameworks") or {}
        s_fw_str = " ".join(str(v).lower() for v in s_fw.values() if v)
        s_tags = " ".join(s.get("tags", [])).lower()
        return all(f in (s_fw_str + " " + s_tags) for f in fw_filters)
    skills = [s for s in skills if has_fw(s)]

print(f"\n{len(skills)} skill(s) matching filters\n")
print(f"  {'ID':<14} {'NS':<6} {'CATEGORY':<22} NAME")
print(f"  {'-'*14} {'-'*6} {'-'*22} {'-'*60}")
for s in skills[:200]:
    sid = s.get("id", "—")
    ns  = s.get("_namespace", "—")
    cat = (s.get("category") or s.get("subdomain", ""))[:22]
    name = s.get("name", "")[:60]
    print(f"  {sid:<14} {ns:<6} {cat:<22} {name}")
if len(skills) > 200:
    print(f"\n  ...and {len(skills)-200} more. Refine your filter.")
PYEOF
}

cmd_show_skill() {
  parse_options "$@"
  local skill_name="${POSITIONAL[0]:-}"
  [[ -z "$skill_name" ]] && die "show-skill requires a skill name or ID"

  ensure_index

  python3 - <<PYEOF
import json
from pathlib import Path

target = "$skill_name".lower()
project_root = "$PROJECT_ROOT"

with open("$COMBINED_INDEX") as f:
    idx = json.load(f)

match = None
for s in idx["skills"]:
    if s.get("name", "").lower() == target or s.get("id", "").lower() == target:
        match = s
        break
if match is None:
    candidates = [s for s in idx["skills"]
                  if target in s.get("name","").lower() or target in s.get("id","").lower()]
    if len(candidates) == 1:
        match = candidates[0]
    elif len(candidates) > 1:
        print(f"Multiple matches for '{target}':")
        for s in candidates[:10]:
            print(f"  {s.get('id','—'):<14} {s.get('name','')}")
        exit(0)
    else:
        print(f"No skill matching '{target}'")
        exit(1)

full_path = match.get("_full_path") or match.get("path")
if full_path:
    p = Path(project_root) / full_path
    if p.exists():
        print(p.read_text())
    else:
        print(f"Skill metadata found but file missing: {p}")
else:
    print(json.dumps(match, indent=2))
PYEOF
}

cmd_list_types() {
  echo -e "\n${BOLD}Engagement types:${NC}\n"
  for ((i=0; i<${#ENGAGEMENT_TYPES[@]}; i+=2)); do
    printf "  ${BLUE}%-20s${NC} %s\n" "${ENGAGEMENT_TYPES[i]}" "${ENGAGEMENT_TYPES[i+1]}"
  done
  echo
}

cmd_rebuild_index() {
  python3 "$PROJECT_ROOT/scripts/build-combined-index.py"
}

cmd_version() {
  echo "telos 1.0.0"
  echo "Project: $PROJECT_ROOT"
  if [[ -f "$COMBINED_INDEX" ]]; then
    local total=$(python3 -c "import json; print(json.load(open('$COMBINED_INDEX'))['total_skills'])")
    echo "Skills (combined): $total"
  fi
  command -v claude >/dev/null && echo "Claude Code: installed" || echo "Claude Code: ${RED}NOT INSTALLED${NC}"
}

main() {
  [[ $# -lt 1 ]] && { usage; exit 1; }
  local cmd="$1"; shift
  case "$cmd" in
    scope)         cmd_scope "$@" ;;
    recon)         cmd_recon "$@" ;;
    testplan)      cmd_testplan "$@" ;;
    execute)       cmd_execute "$@" ;;
    report)        cmd_report "$@" ;;
    list-skills)   cmd_list_skills "$@" ;;
    show-skill)    cmd_show_skill "$@" ;;
    list-types)    cmd_list_types ;;
    rebuild-index) cmd_rebuild_index ;;
    version)       cmd_version ;;
    -h|--help|help) usage ;;
    *)             echo -e "${RED}Unknown command: $cmd${NC}"; usage; exit 1 ;;
  esac
}

main "$@"
